    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.0",
    "postcss": "^8.5.28"
